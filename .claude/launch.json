{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js Dev Server",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": ["-c", "PATH=/opt/homebrew/bin:$PATH npm run dev -- -p $PORT"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "Sanity Studio",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": ["-c", "PATH=/opt/homebrew/bin:$PATH npx sanity dev"],
      "port": 3333
    }
  ]
}
